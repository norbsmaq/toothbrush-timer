# SITE_ADDRESS defaults to ":80" (plain HTTP on any IP).
# Set it to one or more domains (e.g. "example.com, www.example.com") for automatic HTTPS.
{$SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip
	file_server

	# REDIRECT_WWW=true sends www.<domain> to <domain>, keeping the path.
	@www {
		expression `{env.REDIRECT_WWW} == "true"`
		vars_regexp www {host} ^www\.(.+)$
	}
	redir @www https://{re.www.1}{uri} permanent

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Only load the app's own files; no inline scripts, no framing.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# HSTS: on unless ENABLE_HSTS=false. Browsers ignore it over plain HTTP.
	@hsts expression `{env.ENABLE_HSTS} != "false"`
	header @hsts Strict-Transport-Security "max-age=31536000"

	# The service worker and manifest must always be re-checked so app updates are picked up.
	@fresh path /sw.js /manifest.webmanifest
	@static not path /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	header @static Cache-Control "public, max-age=300"
	header /manifest.webmanifest Content-Type "application/manifest+json"
}
