# Leave as :80 to serve over plain HTTP at http://<droplet-ip>/
# Or set to a domain whose DNS A record points at the droplet for automatic HTTPS:
# SITE_ADDRESS=brush.example.com
SITE_ADDRESS=:80

# HSTS tells browsers to only ever use HTTPS for your domain (for a year).
# Recommended with a domain. Browsers ignore it over plain HTTP / IP addresses.
# Set to false if you might switch the domain back to HTTP.
ENABLE_HSTS=true
