# setup-droplet.sh asks for these and fills them in; you can also edit them by hand.
#
# Leave as :80 to serve over plain HTTP at http://<droplet-ip>/
# Or list one or more domains whose DNS A records point at the droplet for automatic HTTPS:
# SITE_ADDRESS="example.com, www.example.com"
SITE_ADDRESS=:80

# HSTS tells browsers to only ever use HTTPS for your domain (for a year).
# Recommended with a domain. Browsers ignore it over plain HTTP / IP addresses.
# Set to false if you might switch the domain back to HTTP.
ENABLE_HSTS=true

# Redirect www.<domain> to <domain> (e.g. www.example.com -> example.com).
# Only turn this on if both addresses are listed in SITE_ADDRESS.
REDIRECT_WWW=false
